{
  "name": "image-utility",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lastmod": "node scripts/lastmod.mjs",
    "verify:prerender": "node scripts/verify-prerender.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:prerender",
    "build:prerender": "vite build --ssr src/entry-prerender.tsx --outDir dist-prerender && node scripts/prerender.mjs && npm run verify:prerender",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "heic-to": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
